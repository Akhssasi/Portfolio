# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# When set, mutating endpoints (POST/PUT/DELETE) and the message inbox
# require a matching `x-admin-key` request header. Leave empty for open
# local development.
ADMIN_API_KEY=

# Base URL the browser uses to reach the API. Defaults to same-origin;
# only set this when the API is hosted on a different origin.
NEXT_PUBLIC_API_URL=
